{
  // Worker "hofladen" für hofladenliste.de
  "name": "hofladen",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Erzeugt public/ und src/generated/ aus den Daten in data/ (läuft vor jedem Deploy)
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/suche", "/plz/*", "/api/*"]
  },
  "routes": [
    { "pattern": "hofladenliste.de", "custom_domain": true },
    { "pattern": "www.hofladenliste.de", "custom_domain": true }
  ],
  // Anonyme Suchstatistik (Tageszähler je PLZ), siehe src/worker.js
  "d1_databases": [
    { "binding": "STATS", "database_name": "hofladen-statistik", "database_id": "e601de06-1b61-47ff-a636-137e5e306312" }
  ],
  "observability": { "enabled": true }
}
