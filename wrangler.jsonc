{
  // Worker "hofladen" für hofladenliste.de
  "name": "hofladen",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  // Erzeugt public/ und src/generated/ aus den Daten in data/ (läuft vor jedem Deploy)
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // HTML-Seiten liefert der Worker aus (301 statt 307 bei Schreibvarianten, 410 für entfernte Höfe).
    // Direkte Aufrufe von …/index.html laufen zuerst durch den Worker und werden per 301 umgeleitet.
    "html_handling": "none",
    "run_worker_first": ["/suche", "/plz/*", "/api/*", "/index.html", "/*/index.html", "/kacheln/*"]
  },
  "routes": [
    { "pattern": "hofladenliste.de", "custom_domain": true },
    { "pattern": "www.hofladenliste.de", "custom_domain": true }
  ],
  // Anonyme Suchstatistik (Tageszähler je PLZ), siehe src/worker.js
  "d1_databases": [
    { "binding": "STATS", "database_name": "hofladen-statistik", "database_id": "e601de06-1b61-47ff-a636-137e5e306312" }
  ],
  // Eigene Kartenkacheln (PMTiles), siehe src/kacheln.js und .github/workflows/karten-erzeugen.yml
  "r2_buckets": [
    { "binding": "KARTEN", "bucket_name": "hofladen-karten" }
  ],
  "observability": { "enabled": true }
}
